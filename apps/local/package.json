{
	"name": "openaeo",
	"version": "0.1.2",
	"description": "The OpenAEO app: command line, local server and dashboard.",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/xenetdev/openaeo.git",
		"directory": "apps/local"
	},
	"type": "module",
	"bin": {
		"openaeo": "./src/main.ts"
	},
	"scripts": {
