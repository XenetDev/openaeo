		"@modelcontextprotocol/sdk": "^1.32.2",
		"@openaeo/engine": "workspace:*",
		"react": "^19.3.1",
		"react-dom": "^19.3.1",
		"zod": "^4"
	},
	"devDependencies": {
		"@types/bun": "^1.4.5",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"@vitejs/plugin-react": "^6.3.0",
		"typescript": "^5.9",
		"vite": "^8.3.8"
